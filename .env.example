# --- Database ---
# Leave DATABASE_URL unset (or delete the line) to use local SQLite (db.sqlite3).
# Set it to a Postgres URL (e.g. from Neon) to use Postgres instead.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# --- Media storage (menu item images) ---
# Leave unset to store uploads on local disk (media/) — fine for local dev.
# Set to your Cloudinary URL to store uploads in Cloudinary instead (needed on
# hosts with no persistent disk, e.g. Render free tier).
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Django core ---
# Leave unset locally (falls back to a dev-only default). Always set a real
# random value in production.
SECRET_KEY=

# "True" for local dev, "False" in production.
DEBUG=True

# Comma-separated list of allowed hostnames, e.g. "myapp.onrender.com".
# Leave unset (defaults to "*") for local dev.
ALLOWED_HOSTS=

# Comma-separated list of full origins Django should trust for CSRF, e.g.
# "https://myapp.onrender.com". Needed in production behind HTTPS.
CSRF_TRUSTED_ORIGINS=
